rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users profile collection - strictly own-profile isolation
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && (
        request.auth.token.admin == true ||
        (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["currency", "isCalmMode", "preferredDesk", "displayName"]) &&
          (!request.resource.data.keys().hasAny(["currency"]) ||
            request.resource.data.currency in ["USD", "EUR"]) &&
          (!request.resource.data.keys().hasAny(["isCalmMode"]) ||
            request.resource.data.isCalmMode is bool)
        )
      );
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Desk Notes collection - strictly user-owned isolation
    match /desk_notes/{noteId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Custom Alerts collection - strictly user-owned isolation
    match /custom_alerts/{alertId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
